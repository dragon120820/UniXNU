+/* Read-only, page-0 bounded boot snapshot. No F12 configuration or frames. */
+static bool
+rmi_diag_packet(const char *name, unsigned base, unsigned off,
+    unsigned len, uint8_t *data)
+{
+	if (base > 0xfeu || off > 0xfeu - base || len == 0u ||
+	    len > 32u || len > 0xffu - (base + off)) {
+		printf("SWEET TS DIAG: %s rejected base=%#x off=%#x len=%u\n",
+		    name, base, off, len);
+		return false;
+	}
+	unsigned address = base + off;
+	int error = rmi_read((uint8_t)address, data, len);
+	if (error != 0) {
+		printf("SWEET TS DIAG: %s read failed addr=%#x len=%u error=%d\n",
+		    name, address, len, error);
+		return false;
+	}
+	printf("SWEET TS DIAG: %s addr=%#x len=%u\n", name, address, len);
+	for (unsigned i = 0; i < len; i += 8u) {
+		unsigned end = i + 8u < len ? i + 8u : len;
+		printf("SWEET TS DIAG: %s +%u", name, i);
+		for (unsigned j = i; j < end; ++j) {
+			printf(" %02x", data[j]);
+		}
+		printf("\n");
+	}
+	return true;
+}
+
+static void
+rmi_query_snapshot(void)
+{
+	uint8_t data[32] = {0};
+	printf("SWEET TS DIAG: query snapshot only; F12 parser unchanged\n");
+	(void)rmi_diag_packet("F01Q11", f01_query, 11u, 10u, data);
+	if (rmi_diag_packet("Q4", f12_query, 4u, 1u, data)) {
+		unsigned n5 = data[0];
+		if (rmi_diag_packet("Q5", f12_query, 5u, n5, data)) {
+			unsigned n6 = data[0];
+			(void)rmi_diag_packet("Q6", f12_query, 6u, n6, data);
+		}
+	}
+	if (rmi_diag_packet("Q7", f12_query, 7u, 1u, data)) {
+		unsigned n8 = data[0];
+		if (rmi_diag_packet("Q8", f12_query, 8u, n8, data)) {
+			unsigned n9 = data[0];
+			(void)rmi_diag_packet("Q9", f12_query, 9u, n9, data);
+		}
+	}
+}
