+__private_extern__ int sweet_kernel_mount_data(dev_t expected_device);
+
+/*
+ * Early boot only: caller has registered md15, holds its backing storage alive,
+ * and has not started userspace or concurrent namespace/devfs/mdev mutation.
+ * No path, data address or mount flags can be supplied by the caller.
+ */
+__private_extern__
+int
+sweet_kernel_mount_data(dev_t expected_device)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct nameidata nd, verify_nd;
+	vnode_t vp, pvp, rootvp;
+	mount_t mp;
+	int error;
+	boolean_t verified;
+
+	if (expected_device == (dev_t)-1 ||
+	    expected_device != mdevlookup(15)) {
+		return ENXIO;
+	}
+	NDINIT(&nd, LOOKUP, OP_MOUNT, FOLLOW | WANTPARENT,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T("/private/var"), ctx);
+	nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+	error = namei(&nd);
+	if (error != 0) {
+		return error;
+	}
+	vp = nd.ni_vp;
+	pvp = nd.ni_dvp;
+	if (vp->v_type != VDIR) {
+		error = ENOTDIR;
+	} else if ((vp->v_flag & (VROOT | VMOUNT)) ||
+	    vp->v_mountedhere != NULL) {
+		error = EBUSY;
+	} else {
+		/* Fixed fresh RW HFS mount; filesystem-specific data stays NULL. */
+		error = mount_common("hfs", pvp, vp, &nd.ni_cnd, USER_ADDR_NULL,
+		    0, KERNEL_MOUNT_KMOUNT | SWEET_KERNEL_MOUNT_DATA, NULL, ctx);
+	}
+	if (error == 0) {
+		/* Published mount: a failed invariant is fatal, never retry/fallback. */
+		mp = vp->v_mountedhere;
+		verified = FALSE;
+		NDINIT(&verify_nd, LOOKUP, OP_LOOKUP, FOLLOW,
+		    UIO_SYSSPACE, CAST_USER_ADDR_T("/private/var"), ctx);
+		verify_nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+		if (namei(&verify_nd) == 0) {
+			rootvp = verify_nd.ni_vp;
+			verified = mp != NULL && rootvp->v_mount == mp &&
+			    (rootvp->v_flag & VROOT) && mp->mnt_vnodecovered == vp &&
+			    strcmp(mp->mnt_vtable->vfc_name, "hfs") == 0 &&
+			    !(mp->mnt_flag & MNT_RDONLY) && mp->mnt_devvp != NULL &&
+			    mp->mnt_devvp->v_type == VBLK &&
+			    mp->mnt_devvp->v_rdev == expected_device &&
+			    mdevlookup(15) == expected_device;
+			vnode_put(rootvp);
+			nameidone(&verify_nd);
+		}
+		if (!verified) {
+			panic("sweet_kernel_mount_data: published mount invariant failed");
+		}
+	}
+	vnode_put(vp);
+	vnode_put(pvp);
+	nameidone(&nd);
+	return error;
+}
+#endif /* SWEET_MERKLE_ROOT */
