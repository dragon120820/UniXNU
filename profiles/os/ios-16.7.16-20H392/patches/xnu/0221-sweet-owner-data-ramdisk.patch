+#define SWEET_KERNEL_MOUNT_DATA 0x80000000U
+_Static_assert((SWEET_KERNEL_MOUNT_DATA & (KERNEL_MOUNT_NOAUTH |
+    KERNEL_MOUNT_PERMIT_UNMOUNT | KERNEL_MOUNT_SNAPSHOT |
+    KERNEL_MOUNT_VOLBYROLE_MASK | KERNEL_MOUNT_BASESYSTEMROOT |
+    KERNEL_MOUNT_DEVFS | KERNEL_MOUNT_FMOUNT | KERNEL_MOUNT_KMOUNT)) == 0,
