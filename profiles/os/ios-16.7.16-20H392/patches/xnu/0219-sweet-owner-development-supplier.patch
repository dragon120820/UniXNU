new file mode 100644
--- /dev/null
+++ b/bsd/dev/sweet_owner_policy.c
@@ -0,0 +1,54 @@
+/* Source-owned DEVELOPMENT supply. Not an Apple ticket or a whole-bootset seal. */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_MERKLE_ROOT)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/startup.h>
+#include <libkern/libkern.h>
+#include <libkern/section_keywords.h>
+#include <libkern/crypto/crypto_internal.h>
+#include "sweet_merkle_policy.h"
+#include "sweet_owner_material.h"
+extern const struct vr_crypto vr_xnu_crypto;
+const uint8_t *sweet_owner_namespace(size_t *bytes);
+SECURITY_READ_ONLY_LATE(static bool) owner_registered;
+
+static void __startup_func
+sweet_owner_startup(void)
+{
+    struct vrm_view verified;
+    if (owner_registered || !g_crypto_funcs ||
+        !g_crypto_funcs->ccrsa_make_pub_fn ||
+        !g_crypto_funcs->ccrsa_verify_pkcs1v15_fn) {
+        panic("SWEET owner: crypto not initialized or duplicate supplier");
+    }
+    owner_policy.crypto = vr_xnu_crypto;
+    if (vrm_open(owner_envelope, sizeof(owner_envelope), owner_policy.key,
+                 owner_policy.min_generation, &owner_policy.crypto, &verified) != VRM_OK) {
+        panic("SWEET owner: signed development policy refused");
+    }
+    if (verified.image_bytes != owner_policy.image_bytes ||
+        memcmp(verified.volume_uuid, owner_policy.volume_uuid, 16) != 0) {
+        panic("SWEET owner: authenticated identity mismatch");
+    }
+    bzero(&verified, sizeof(verified));
+    if (sweet_merkle_register_protected_policy(&owner_policy) != 0) {
+        panic("SWEET owner: policy registration refused");
+    }
+    owner_registered = true;
+}
+/* Existing source-corecrypto FIRST performs POST/registration first. The whole
+ * __DATA,__const envelope/policy/pointer must be sealed before BSD device init.
+ * A final linked-image inspection is required; section syntax is not proof. */
+STARTUP(EARLY_BOOT, STARTUP_RANK_MIDDLE, sweet_owner_startup);
+
+/* Identity material only: this is NOT permission to publish metadata. The root
+ * bridge must separately prove final mounted RO HFS / exact authenticated dev,
+ * UUID, healthy transport and no pivot, before calling the IOKit publisher. */
+const uint8_t *
+sweet_owner_namespace(size_t *bytes)
+{
+    if (!bytes || !owner_registered) return NULL;
+    *bytes = sizeof(owner_namespace);
+    return owner_namespace;
+}
+#endif
