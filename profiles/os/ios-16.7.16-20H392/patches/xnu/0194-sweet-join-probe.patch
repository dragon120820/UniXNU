 void
 cpu_quiescent_counter_join(__unused uint64_t ctime)
 {
+	/* openplus: the panel is the only console that survives this path. Speak
+	 * up only when the thread register is already dead, so a healthy boot
+	 * stays silent. */
+	{
+		unsigned long j_tpidr, j_lr, j_sp;
+		static int j_reported;
+
+		__asm__ volatile("mrs %0, TPIDR_EL1" : "=r" (j_tpidr));
+		if (j_tpidr == 0 && !j_reported) {
+			j_reported = 1;
+			__asm__ volatile("mov %0, x30" : "=r" (j_lr));
+			__asm__ volatile("mov %0, sp" : "=r" (j_sp));
+			sweet_early_printf("JOIN tpidr=0 lr=%lx sp=%lx\n",
+			    j_lr, j_sp);
+			sweet_early_mark(11, "join entered with a dead thread");
+		}
+	}
 	struct cpu_quiesce *st = PERCPU_GET(cpu_quiesce);
 	__assert_only int cpuid = cpu_number();
 
