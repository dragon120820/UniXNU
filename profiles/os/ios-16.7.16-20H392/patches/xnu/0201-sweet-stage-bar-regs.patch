--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -508,2 +508,10 @@
 .macro SWEET_STAGE_BAR row, colr
+	/* openplus: one call site sits between `mov x0, x20` and the ret into
+	 * arm_init, and x20 carries the physical boot_args pointer.  Saving
+	 * x0-x4 keeps the bars from handing the kernel a framebuffer address
+	 * (it was printing ARGS p=9dd21300 while DarwinBoot wrote 0x8d240000). */
+	sub	sp, sp, #48
+	stp	x0, x1, [sp]
+	stp	x2, x3, [sp, #16]
+	str	x4, [sp, #32]
 	MOV64	x0, (0x9d400000 + (\row) * 4320)
@@ -520,2 +528,6 @@
 	dsb	sy
+	ldp	x0, x1, [sp]
+	ldp	x2, x3, [sp, #16]
+	ldr	x4, [sp, #32]
+	add	sp, sp, #48
 .endm
