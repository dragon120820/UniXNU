--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -363,2 +363,14 @@
 
+	/*
+	 * openplus: bind the bootstrap thread before the platform expert runs.
+	 * PE_init_platform reaches kprintf() on the serial path, and kprintf asks
+	 * cpu_number(), which reads TPIDR_EL1 through getCpuDatap(). Until this
+	 * call the register is still zero, so the first print faults at [0x220]
+	 * with no console left to report it. The thread needs nothing that
+	 * PE_init_platform sets up; thread_bootstrap() only fills a template.
+	 */
+	thread = thread_bootstrap();
+	thread->machine.CpuDatap = &BootCpuData;
+	thread->machine.pcpu_data_base = (vm_offset_t)0;
+	machine_set_current_thread(thread);
 	PE_init_platform(FALSE, args); /* Get platform expert set up */
@@ -442,6 +454,2 @@
 
-	thread = thread_bootstrap();
-	thread->machine.CpuDatap = &BootCpuData;
-	thread->machine.pcpu_data_base = (vm_offset_t)0;
-	machine_set_current_thread(thread);
 
