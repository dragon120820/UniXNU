+
+extern dev_t mdevadd(int, uint64_t, unsigned int, int);
+extern dev_t mdevlookup(int);
+extern int sweet_owner_mounted_identity(dev_t, const uint8_t[16], uint8_t[48]);
+extern int sweet_kernel_mount_preboot(dev_t);
+extern int sweet_kernel_prepare_preboot(dev_t,const uint8_t[48]);
+#define OWNER_PREBOOT_BYTES ((size_t)268435456)
+#define OWNER_PREBOOT_CHUNK ((size_t)65536)
+static const char owner_seed_path[] = "/usr/standalone/owner/preboot.hfsx";
+static const uint8_t owner_seed_sha[32] = {
+ 0xa2,0x7d,0xaa,0xcc,0x3d,0x2d,0x9e,0x22,0xeb,0x62,0x9b,0xf1,0x7b,0x79,0x75,0x17,0xf7,0x35,0xeb,0x40,0xc4,0x0c,0x9a,0xe8,0xb3,0xb4,0x14,0xc7,0x83,0xdb,0x1f,0x14
+};
+static const uint8_t owner_preboot_uuid[16] = {
+ 0x69,0xcf,0xc2,0x5d,0xf2,0x98,0x3c,0x20,0x8f,0xbf,0xa9,0x2d,0x39,0x11,0x4e,0x8f
+};
+/* Runtime BSS, deliberately NOT late-RO: all writes occur after lockdown. */
+static bool owner_preboot_called;
+static void *owner_preboot_backing;
+
+static int
+owner_fs_uuid(mount_t mp, uint8_t uuid[16])
+{
+ struct vfs_attr a;
+ bzero(&a,sizeof(a)); VFSATTR_INIT(&a); VFSATTR_WANTED(&a,f_uuid);
+ int e=vfs_getattr(mp,&a,vfs_context_kernel());
+ if(e) return e;
+ if(!VFSATTR_IS_SUPPORTED(&a,f_uuid)) return EOPNOTSUPP;
+ memcpy(uuid,a.f_uuid,16); return 0;
+}
+
+static int
+owner_root_valid(vnode_t root,mount_t mp,vnode_t devvp,dev_t dev,
+ const uint8_t uuid[16],const uint8_t expected[48])
+{
+ uint8_t actual[16],digest[48];
+ vnode_t now=vfs_rootvnode();
+ if(now==NULLVP) return ENXIO;
+ bool same=now==root && vnode_mount(now)==mp && vnode_vtype(now)==VDIR;
+ vnode_put(now);
+ if(!same || vnode_mount(root)!=mp) return ESTALE;
+ const struct vfsstatfs *s=vfs_statfs(mp);
+ if(!s || strncmp(s->f_fstypename,"hfs",sizeof(s->f_fstypename)) || !(vfs_flags(mp)&MNT_RDONLY)) return EROFS;
+ vnode_t d=vfs_devvp(mp);
+ if(d==NULLVP) return ENXIO;
+ same=d==devvp && vnode_vtype(d)==VBLK && vnode_specrdev(d)==dev;
+ vnode_put(d);
+ if(!same) return ESTALE;
+ int e=owner_fs_uuid(mp,actual);
+ if(e || memcmp(actual,uuid,16)) return e ? e : ESTALE;
+ e=sweet_owner_mounted_identity(dev,uuid,digest);
+ if(e || memcmp(digest,expected,48)) { bzero(digest,sizeof(digest)); return e ? e : ESTALE; }
+ bzero(digest,sizeof(digest)); return 0;
+}
+
+/* Actual held-vnode IO loop, extracted unchanged for host failure tests. */
+static int
+owner_read_seed(vnode_t seed,void *buffer,size_t bytes,vfs_context_t ctx)
+{
+ size_t offset=0;
+ while(offset<bytes) {
+  size_t n=bytes-offset;
+  if(n>OWNER_PREBOOT_CHUNK) n=OWNER_PREBOOT_CHUNK;
+  int residual=0;
+  int e=vn_rdwr(UIO_READ,seed,(caddr_t)buffer+offset,(int)n,(off_t)offset,
+   UIO_SYSSPACE,IO_NODELOCKED|IO_NOCACHE|IO_RAOFF,vfs_context_ucred(ctx),
+   &residual,vfs_context_proc(ctx));
+  if(e || residual!=0) return e ? e : EIO;
+  offset+=n;
+ }
+ return 0;
+}
+
+int
+sweet_owner_prepare_preboot(void)
+{
+ if(owner_preboot_called) return EALREADY;
+ owner_preboot_called=true;
+ int e=ENXIO; bool busy=false,opened=false,handed=false;
+ vnode_t root=NULLVP,devvp=NULLVP,seed=NULLVP,data=NULLVP;
+ mount_t mp=NULL; void *buffer=NULL; off_t size=0;
+ dev_t dev=NODEV,md=NODEV;
+ uint8_t uuid[16]={0},digest[48]={0},actual_sha[32]={0};
+ SHA256_CTX hash;
+ bzero(&hash,sizeof(hash));
+ vfs_context_t ctx=vfs_context_kernel();
+ root=vfs_rootvnode(); if(root==NULLVP) goto out;
+ mp=vnode_mount(root); if(mp==NULL) goto out;
+ e=vfs_busy(mp,LK_NOWAIT); if(e) goto out; busy=true;
+ devvp=vfs_devvp(mp); if(devvp==NULLVP || vnode_vtype(devvp)!=VBLK) {e=ENXIO;goto out;}
+ dev=vnode_specrdev(devvp);
+ e=owner_fs_uuid(mp,uuid); if(e) goto out;
+ e=sweet_owner_mounted_identity(dev,uuid,digest); if(e) goto out;
+ e=owner_root_valid(root,mp,devvp,dev,uuid,digest); if(e) goto out;
+ if(mdevlookup(14)!=(dev_t)-1) {e=EBUSY;goto out;}
+ e=vnode_lookup(owner_seed_path,VNODE_LOOKUP_NOFOLLOW|VNODE_LOOKUP_NOCROSSMOUNT,&seed,ctx);
+ if(e) goto out;
+ if(vnode_vtype(seed)!=VREG || vnode_mount(seed)!=mp) {e=EXDEV;goto out;}
+ e=vnode_size(seed,&size,ctx); if(e) goto out;
+ if(size<0 || (uint64_t)size!=OWNER_PREBOOT_BYTES) {e=EINVAL;goto out;}
+ e=VNOP_OPEN(seed,FREAD,ctx); if(e) goto out; opened=true;
+ buffer=kalloc_data(OWNER_PREBOOT_BYTES,Z_WAITOK);
+ if(buffer==NULL) {e=ENOMEM;goto out;}
+ if(((uintptr_t)buffer&4095)!=0) {e=EINVAL;goto out;}
+ e=owner_read_seed(seed,buffer,OWNER_PREBOOT_BYTES,ctx); if(e) goto out;
+ SHA256_Init(&hash); SHA256_Update(&hash,buffer,OWNER_PREBOOT_BYTES); SHA256_Final(actual_sha,&hash);
+ if(memcmp(actual_sha,owner_seed_sha,32)) {e=EAUTH;goto out;}
+ e=vnode_size(seed,&size,ctx); if(e) goto out;
+ if(size!=(off_t)OWNER_PREBOOT_BYTES || vnode_vtype(seed)!=VREG || vnode_mount(seed)!=mp) {e=ESTALE;goto out;}
+ e=owner_root_valid(root,mp,devvp,dev,uuid,digest); if(e) goto out;
+ e=VNOP_CLOSE(seed,FREAD,ctx); opened=false; if(e) goto out;
+ /* Publish only after all authentication. Own until reboot even on partial add. */
+ owner_preboot_backing=buffer; handed=true;
+ md=mdevadd(14,(uint64_t)(uintptr_t)buffer>>12,(unsigned int)(OWNER_PREBOOT_BYTES>>12),0);
+ if(md==(dev_t)-1 || mdevlookup(14)!=md) {e=ENXIO;goto out;}
+ e=sweet_kernel_mount_preboot(md); if(e) goto out;
+ e=vnode_lookup("/private/preboot",VNODE_LOOKUP_NOFOLLOW,&data,ctx); if(e) goto out;
+ mount_t data_mp=vnode_mount(data);
+ const struct vfsstatfs *s=data_mp ? vfs_statfs(data_mp) : NULL;
