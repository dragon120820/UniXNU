+#if SWEET_MERKLE_ROOT
+static int
+sweet_preboot_mkdir1at(vfs_context_t ctx, user_addr_t path, struct vnode_attr *vap, int fd,
+    enum uio_seg segflg)
+{
+	vnode_t vp, dvp;
+	int error;
+	int update_flags = 0;
+	int batched;
+	struct nameidata nd;
+
+	AUDIT_ARG(mode, vap->va_mode);
+	NDINIT(&nd, CREATE, OP_MKDIR, LOCKPARENT | AUDITVNPATH1, segflg,
+	    path, ctx);
+	nd.ni_cnd.cn_flags |= WILLBEDIR;
+	nd.ni_flag = NAMEI_COMPOUNDMKDIR | NAMEI_NOFOLLOW_ANY;
+
+continue_lookup:
+	error = nameiat(&nd, fd);
+	if (error) {
+		return error;
+	}
+	dvp = nd.ni_dvp;
+	vp = nd.ni_vp;
+
+	if (vp != NULL) {
+		error = EEXIST;
+		goto out;
+	}
+
+	batched = vnode_compound_mkdir_available(dvp);
+
+	VATTR_SET(vap, va_type, VDIR);
+
+	/*
+	 * XXX
+	 * Don't authorize in VFS for compound VNOP.... mkdir -p today assumes that it will
+	 * only get EXISTS or EISDIR for existing path components, and not that it could see
+	 * EACCESS/EPERM--so if we authorize for mkdir on "/" for "mkdir -p /tmp/foo/bar/baz"
+	 * it will fail in a spurious  manner.  Need to figure out if this is valid behavior.
+	 */
+	if ((error = vn_authorize_mkdir(dvp, &nd.ni_cnd, vap, ctx, NULL)) != 0) {
+		if (error == EACCES || error == EPERM) {
+			int error2;
+
+			nameidone(&nd);
+			vnode_put(dvp);
+			dvp = NULLVP;
+
+			/*
+			 * Try a lookup without "NAMEI_COMPOUNDVNOP" to make sure we return EEXIST
+			 * rather than EACCESS if the target exists.
+			 */
+			NDINIT(&nd, LOOKUP, OP_MKDIR, AUDITVNPATH1, segflg,
+			    path, ctx);
+			nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+			error2 = nameiat(&nd, fd);
+			if (error2) {
+				goto out;
+			} else {
+				vp = nd.ni_vp;
+				error = EEXIST;
+				goto out;
+			}
+		}
+
+		goto out;
+	}
+
+#if CONFIG_FILE_LEASES
+	vnode_breakdirlease(dvp, false, O_WRONLY);
+#endif
+
+	/*
+	 * make the directory
+	 */
+	if ((error = vn_create(dvp, &vp, &nd, vap, 0, 0, NULL, ctx)) != 0) {
+		if (error == EKEEPLOOKING) {
+			nd.ni_vp = vp;
+			goto continue_lookup;
+		}
+
+		goto out;
+	}
+
+	// Make sure the name & parent pointers are hooked up
+	if (vp->v_name == NULL) {
+		update_flags |= VNODE_UPDATE_NAME;
+	}
+	if (vp->v_parent == NULLVP) {
+		update_flags |= VNODE_UPDATE_PARENT;
+	}
+
+	if (update_flags) {
+		vnode_update_identity(vp, dvp, nd.ni_cnd.cn_nameptr, nd.ni_cnd.cn_namelen, nd.ni_cnd.cn_hash, update_flags);
+	}
+
+#if CONFIG_FSE
+	add_fsevent(FSE_CREATE_DIR, ctx, FSE_ARG_VNODE, vp, FSE_ARG_DONE);
+#endif
+
+out:
+	/*
+	 * nameidone has to happen before we vnode_put(dvp)
+	 * since it may need to release the fs_nodelock on the dvp
+	 */
+	nameidone(&nd);
+
+	if (vp) {
+		vnode_put(vp);
+	}
+	if (dvp) {
+		vnode_put(dvp);
+	}
+
+	return error;
+}
+/* Private fixed-path boot operation, not a syscall and not an owner publisher.
+ * Caller MUST serialize before init: no namespace/device mutation, remount,
+ * pivot or unmount, and keep md14 storage alive. Any nonzero return is fatal
+ * to the caller: mkdir/rename/mtime effects are NOT rolled back. The current
+ * RO root must already have been authenticated by the caller's boot policy.
+ */
+__private_extern__ int sweet_kernel_prepare_preboot(dev_t expected_device,
+    const uint8_t namespace48[48]);
+
+static int
+sweet_preboot_lookup(const char *path, vnode_t *vpp, vfs_context_t ctx)
+{
+	struct nameidata nd;
+	int error;
+
+	*vpp = NULLVP;
+	NDINIT(&nd, LOOKUP, OP_LOOKUP, NOFOLLOW, UIO_SYSSPACE,
+	    CAST_USER_ADDR_T(path), ctx);
+	nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+	error = namei(&nd);
+	if (error != 0) {
+		return error;
+	}
+	*vpp = nd.ni_vp; /* Transfer exactly one iocount, not a usecount. */
+	nameidone(&nd);
+	return 0;
+}
+
+static boolean_t
+sweet_preboot_root_ok(vnode_t vp, mount_t mp, dev_t expected_device)
+{
+	return expected_device != (dev_t)-1 && mdevlookup(14) == expected_device &&
+	       vp->v_type == VDIR && (vp->v_flag & VROOT) &&
+	       vp->v_mountedhere == NULL && vp->v_mount == mp &&
+	       mp != NULL && !(mp->mnt_flag & MNT_RDONLY) &&
+	       strcmp(mp->mnt_vtable->vfc_name, "hfs") == 0 &&
+	       mp->mnt_devvp != NULL && mp->mnt_devvp->v_type == VBLK &&
+	       mp->mnt_devvp->v_rdev == expected_device &&
+	       mp->mnt_vnodecovered != NULL &&
+	       mp->mnt_vnodecovered->v_type == VDIR &&
+	       !(mp->mnt_vnodecovered->v_flag & VROOT) &&
+	       mp->mnt_vnodecovered->v_mountedhere == mp;
+}
+
+static int
+sweet_preboot_check_link(vnode_t linkvp, vfs_context_t ctx)
+{
+	static const char target[] = "/usr/standalone/owner/Cryptexes";
+	char bytes[sizeof(target)];
+	UIO_STACKBUF(uio_buf, 1);
+	uio_t uio;
+	int error = 0;
+	size_t length;
+
+	if (linkvp->v_type != VLNK || linkvp->v_mountedhere != NULL ||
+	    (linkvp->v_flag & VROOT)) {
+		return EINVAL;
+	}
+	/* Same MAC + vnode_authorize + VNOP_READLINK sequence as the real TU.
+	 * Stack-backed uio owns no heap allocation. One spare byte detects longer
+	 * targets and stored trailing NUL. Never follow to authenticate a source. */
+	uio = uio_createwithbuffer(1, 0, UIO_SYSSPACE, UIO_READ,
+	    &uio_buf[0], sizeof(uio_buf));
+	if (uio == NULL) {
+		return ENOMEM;
+	}
+	error = uio_addiov(uio, CAST_USER_ADDR_T(bytes), sizeof(bytes));
+	if (error != 0) {
+		return error;
+	}
+#if CONFIG_MACF
+	error = mac_vnode_check_readlink(ctx, linkvp);
+#endif
+	if (error == 0) {
+		error = vnode_authorize(linkvp, NULL, KAUTH_VNODE_READ_DATA, ctx);
+	}
+	if (error == 0) {
+		error = VNOP_READLINK(linkvp, uio, ctx);
+	}
+	length = sizeof(bytes) - uio_resid(uio);
+	if (error == 0 && (length != sizeof(target) - 1 ||
+	    memcmp(bytes, target, sizeof(target) - 1) != 0)) {
+		error = EINVAL;
+	}
+	return error;
+}
+
+static int
+sweet_preboot_newdir(const char *path, mount_t mp, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+	vnode_t vp = NULLVP;
+	int error;
+
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, 0755);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	error = sweet_preboot_mkdir1at(ctx, CAST_USER_ADDR_T(path), &va,
+	    AT_FDCWD, UIO_SYSSPACE);
+	if (error != 0) {
+		return error; /* EEXIST is deliberately fatal, never mkdir -p. */
+	}
+	error = sweet_preboot_lookup(path, &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	if (vp->v_type != VDIR || vp->v_mount != mp ||
+	    (vp->v_flag & VROOT) || vp->v_mountedhere != NULL) {
+		error = EINVAL;
+		goto out;
+	}
+	VATTR_INIT(&va);
+	VATTR_WANTED(&va, va_mode);
+	VATTR_WANTED(&va, va_uid);
+	VATTR_WANTED(&va, va_gid);
+	error = vnode_getattr(vp, &va, ctx);
+	if (error == 0 && (!VATTR_IS_SUPPORTED(&va, va_mode) ||
+	    !VATTR_IS_SUPPORTED(&va, va_uid) || !VATTR_IS_SUPPORTED(&va, va_gid) ||
+	    (va.va_mode & ALLPERMS) != 0755 || va.va_uid != 0 || va.va_gid != 0)) {
+		error = EINVAL;
+	}
+out:
+	vnode_put(vp);
+	return error;
+}
+
+__private_extern__
+int
+sweet_kernel_prepare_preboot(dev_t expected_device,
+    const uint8_t namespace48[48])
+{
+	static const char hex[] = "0123456789ABCDEF";
+	static const char * const suffixes[] = { "", "/usr", "/usr/standalone" };
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t root = NULLVP, payload = NULLVP, link = NULLVP;
+	vnode_t ro_root = NULLVP, ro_target = NULLVP, check = NULLVP;
+	mount_t mp = NULL;
+	char ns[97], path[192], destination[192];
+	int error, n;
+	unsigned int i;
+
+	if (namespace48 == NULL || expected_device == (dev_t)-1 ||
+	    mdevlookup(14) != expected_device) {
+		return EINVAL;
+	}
+	for (i = 0; i < 48; i++) {
+		ns[2 * i] = hex[namespace48[i] >> 4];
+		ns[2 * i + 1] = hex[namespace48[i] & 15];
+	}
+	ns[96] = '\0';
+#define SWEET_PB_LOOKUP(p, v) do { \
+	error = sweet_preboot_lookup((p), &(v), ctx); \
+	if (error != 0) { goto out; } \
+} while (0)
+#define SWEET_PB_REQUIRE(x) do { \
+	if (!(x)) { error = EINVAL; goto out; } \
+} while (0)
+	SWEET_PB_LOOKUP("/private/preboot", root);
+	mp = root->v_mount;
+	SWEET_PB_REQUIRE(sweet_preboot_root_ok(root, mp, expected_device));
+	SWEET_PB_LOOKUP("/private/preboot/payload", payload);
+	/* NOFOLLOW_ANY alone is not proof about the final component. */
+	SWEET_PB_REQUIRE(payload->v_type == VDIR && payload->v_mount == mp &&
+	    !(payload->v_flag & VROOT) && payload->v_mountedhere == NULL);
+	SWEET_PB_LOOKUP("/", ro_root);
+	SWEET_PB_REQUIRE(ro_root == rootvnode && ro_root->v_type == VDIR &&
+	    (ro_root->v_flag & VROOT) && ro_root->v_mountedhere == NULL &&
+	    ro_root->v_mount != mp && (ro_root->v_mount->mnt_flag & MNT_RDONLY));
+	SWEET_PB_LOOKUP("/usr/standalone/owner/Cryptexes", ro_target);
+	SWEET_PB_REQUIRE(ro_target->v_type == VDIR &&
+	    ro_target->v_mount == ro_root->v_mount &&
+	    !(ro_target->v_flag & VROOT) && ro_target->v_mountedhere == NULL);
+	SWEET_PB_LOOKUP("/private/preboot/Cryptexes", link);
+	SWEET_PB_REQUIRE(link->v_mount == mp);
+	error = sweet_preboot_check_link(link, ctx);
+	if (error != 0) { goto out; }
+	for (i = 0; i < sizeof(suffixes) / sizeof(suffixes[0]); i++) {
+		n = snprintf(path, sizeof(path), "/private/preboot/%s%s", ns, suffixes[i]);
+		SWEET_PB_REQUIRE(n > 0 && (size_t)n < sizeof(path));
+		error = sweet_preboot_newdir(path, mp, ctx);
+		if (error != 0) { goto out; }
+	}
+	n = snprintf(destination, sizeof(destination),
+	    "/private/preboot/%s/usr/standalone/firmware", ns);
+	SWEET_PB_REQUIRE(n > 0 && (size_t)n < sizeof(destination));
+	error = renameat_internal(ctx, AT_FDCWD,
+	    CAST_USER_ADDR_T("/private/preboot/payload"), AT_FDCWD,
+	    CAST_USER_ADDR_T(destination), UIO_SYSSPACE,
+	    RENAME_EXCL | RENAME_NOFOLLOW_ANY);
+	if (error != 0) { goto out; }
+	SWEET_PB_LOOKUP(destination, check);
+	SWEET_PB_REQUIRE(check == payload && check->v_type == VDIR &&
+	    check->v_mount == mp && !(check->v_flag & VROOT) &&
+	    check->v_mountedhere == NULL);
+	vnode_put(check); check = NULLVP;
+	error = sweet_preboot_lookup("/private/preboot/payload", &check, ctx);
+	if (error != ENOENT) {
+		if (error == 0) { error = EEXIST; }
+		goto out;
+	}
+	SWEET_PB_LOOKUP("/private/preboot", check);
+	SWEET_PB_REQUIRE(check == root && sweet_preboot_root_ok(root, mp, expected_device));
+	vnode_put(check); check = NULLVP;
+	SWEET_PB_LOOKUP("/private/preboot/Cryptexes", check);
+	SWEET_PB_REQUIRE(check == link && check->v_mount == mp);
+	error = sweet_preboot_check_link(check, ctx);
+	if (error != 0) { goto out; }
+	vnode_put(check); check = NULLVP;
+	SWEET_PB_LOOKUP("/", check);
+	SWEET_PB_REQUIRE(check == ro_root && check == rootvnode &&
+	    (check->v_mount->mnt_flag & MNT_RDONLY));
+	vnode_put(check); check = NULLVP;
+	SWEET_PB_LOOKUP("/usr/standalone/owner/Cryptexes", check);
+	SWEET_PB_REQUIRE(check == ro_target && check->v_type == VDIR &&
+	    check->v_mount == ro_root->v_mount && check->v_mountedhere == NULL &&
+	    !(check->v_flag & VROOT));
+	error = 0;
+out:
+	if (check != NULLVP) { vnode_put(check); }
+	if (ro_target != NULLVP) { vnode_put(ro_target); }
+	if (ro_root != NULLVP) { vnode_put(ro_root); }
+	if (link != NULLVP) { vnode_put(link); }
+	if (payload != NULLVP) { vnode_put(payload); }
+	if (root != NULLVP) { vnode_put(root); }
+#undef SWEET_PB_REQUIRE
+#undef SWEET_PB_LOOKUP
+	return error;
+}
+#endif /* SWEET_MERKLE_ROOT */
 
