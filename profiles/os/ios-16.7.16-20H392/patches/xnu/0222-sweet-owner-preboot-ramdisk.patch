+/* Source-owned DEVELOPMENT Data seed. Before init, serialized, no pivots/remounts.
+ * Not wired to a build yet. The signed root must contain this exact seed first.
+ * Never frees backing after attempting mdevadd: it may have partially published.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_MERKLE_ROOT)
+#include <sys/types.h>
+#include <sys/param.h>
+#include <sys/errno.h>
+#include <sys/mount.h>
+#include <sys/vnode.h>
