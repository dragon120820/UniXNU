+/* Fixed md14 /private/preboot, same normal mount_common authorization.
+ * Caller serializes before init and retains md14 storage; no retry on failure.
+ */
+__private_extern__
+int
+sweet_kernel_mount_preboot(dev_t expected_device)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct nameidata nd, verify_nd;
+	vnode_t vp, pvp, rootvp;
+	mount_t mp;
+	int error;
+	boolean_t verified;
+
+	if (expected_device == (dev_t)-1 ||
+	    expected_device != mdevlookup(14)) {
+		return ENXIO;
+	}
+	NDINIT(&nd, LOOKUP, OP_MOUNT, FOLLOW | WANTPARENT,
+	    UIO_SYSSPACE, CAST_USER_ADDR_T("/private/preboot"), ctx);
+	nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+	error = namei(&nd);
+	if (error != 0) {
+		return error;
+	}
+	vp = nd.ni_vp;
+	pvp = nd.ni_dvp;
+	if (vp->v_type != VDIR) {
+		error = ENOTDIR;
+	} else if (vp->v_mount != rootvnode->v_mount ||
+	    (vp->v_flag & (VROOT | VMOUNT)) ||
+	    vp->v_mountedhere != NULL) {
+		error = EBUSY;
+	} else {
+		/* Fixed fresh RW HFS mount; filesystem-specific data stays NULL. */
+		error = mount_common("hfs", pvp, vp, &nd.ni_cnd, USER_ADDR_NULL,
+		    0, KERNEL_MOUNT_KMOUNT | SWEET_KERNEL_MOUNT_PREBOOT, NULL, ctx);
+	}
+	if (error == 0) {
+		/* Published mount: a failed invariant is fatal, never retry/fallback. */
+		mp = vp->v_mountedhere;
+		verified = FALSE;
+		NDINIT(&verify_nd, LOOKUP, OP_LOOKUP, FOLLOW,
+		    UIO_SYSSPACE, CAST_USER_ADDR_T("/private/preboot"), ctx);
+		verify_nd.ni_flag |= NAMEI_NOFOLLOW_ANY;
+		if (namei(&verify_nd) == 0) {
+			rootvp = verify_nd.ni_vp;
+			verified = mp != NULL && rootvp->v_type == VDIR &&
+			    rootvp->v_mountedhere == NULL && rootvp->v_mount == mp &&
+			    (rootvp->v_flag & VROOT) && mp->mnt_vnodecovered == vp &&
+			    strcmp(mp->mnt_vtable->vfc_name, "hfs") == 0 &&
+			    !(mp->mnt_flag & MNT_RDONLY) && mp->mnt_devvp != NULL &&
+			    mp->mnt_devvp->v_type == VBLK &&
+			    mp->mnt_devvp->v_rdev == expected_device &&
+			    mdevlookup(14) == expected_device;
+			vnode_put(rootvp);
+			nameidone(&verify_nd);
+		}
+		if (!verified) {
+			panic("sweet_kernel_mount_preboot: published mount invariant failed");
+		}
+	}
+	vnode_put(vp);
+	vnode_put(pvp);
+	nameidone(&nd);
+	return error;
+}
